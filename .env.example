# Copy this to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
DATABASE_URL=sqlite:///./integrity_iq.db
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- IBM Granite (mandatory per the AICTE problem statement) ---
# "watsonx" = call IBM watsonx.ai's hosted Granite model (IBM Cloud Lite).
# "local"   = run a small Granite checkpoint locally via transformers (no cloud needed).
GRANITE_BACKEND=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# --- Dashboard ---
API_BASE_URL=http://localhost:8000
